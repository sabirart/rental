# Copy this file to .env for local development and fill in real values.
# In production (Render, etc.), set these in the hosting dashboard instead -
# never commit a real .env file.

NODE_ENV=development
PORT=5000

# Postgres connection string from your database provider (e.g. Supabase:
# Project Settings -> Database -> Connection string -> URI).
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Leave this unset/true for any hosted provider (Supabase, Neon, Render
# Postgres, etc.) - they all require SSL. Only set to "false" for a local
# Postgres install with no TLS configured.
# DATABASE_SSL=false

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail app password (not your regular Gmail password) - used to send
# verification/reset OTP emails.
EMAIL_USER=
EMAIL_PASS=
